{
  "name": "key-sounds",
  "version": "1.0.0",
  "description": "Play sounds from your keyboard, with custom sounds and trimming",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.example.keysounds",
    "productName": "Key Sounds",
    "files": [
      "main.js",
      "index.html"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "author": "Akkalapotu Sathwik <Sakkalap@student.gitam.edu.com>",
  "license": "MIT"
}