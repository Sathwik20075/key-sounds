{
  "name": "key-sounds",
  "version": "1.4.0",
  "description": "Play sounds from your keyboard, with custom sounds and trimming",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.example.keysounds",
    "productName": "Key Sounds",
    "npmRebuild": false,
    "asarUnpack": ["**/node_modules/uiohook-napi/**"],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "author": "Akkalapotu Sathwik <Sakkalap@student.gitam.edu.com>",
  "license": "MIT",
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  }
}
